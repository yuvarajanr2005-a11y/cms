# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave as is for auto in-memory MongoDB fallback or point to MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/college_complaints

# JWT Authentication
JWT_ACCESS_SECRET=dev_access_secret_key_college_cms_super_safe_random_value_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_key_college_cms_super_safe_random_value_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Optional - Memory storage fallback is built-in if credentials not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mailer (Optional - Automatic Ethereal email fallback is built-in if unset)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="College Helpdesk" <support@college.edu>
